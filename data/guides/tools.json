            { "nameJa": "USBハッキングツール（満タン）", "nameEn": "USB Hacking Tool (full)", "qty": 2, "shipmentId": "usb_1_cumulative" },
            { "nameJa": "現金", "nameEn": "Cash", "qty": 50000, "cash": true }
