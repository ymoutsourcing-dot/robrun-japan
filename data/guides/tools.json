        { "label": "売値（故買屋）", "value": "$5,000", "sources": ["rri-items", "rrg-items"] },
        { "label": "サイズ", "value": "2×1", "sources": ["rri-items", "rrg-items"] }
      ],
      "obtainJa": [
        { "text": "物々交換でのみ入手（レニーのモーテルの怪しいドア／Suspicious Door）。レシピは2種類。", "sources": ["rri-items", "rrg-items", "wiki-decoder"] }
      ],
      "barter": [
        {
          "inputs": [
            { "nameJa": "デコーダー（アンコモン）", "nameEn": "Decoder", "qty": 3, "toolId": "decoder-uncommon" },
            { "nameJa": "現金", "nameEn": "Cash", "qty": 10000, "cash": true }
          ],
          "outputJa": "デコーダー（エピック）",
          "qty": 1,
          "sources": ["rri-barter", "rrg-items"]
        },
        {
          "inputs": [{ "nameJa": "アクションカメラ（エピック・満タン）", "nameEn": "Action Camera (full)", "qty": 1, "shipmentId": "action_camera_2_cumulative" }],
          "outputJa": "デコーダー（エピック）",
          "qty": 1,
          "sources": ["rri-barter", "rrg-items"],
          "noteJa": "アクションカメラ（エピック）は悪名レベルに応じた犯罪行為で 70 ポイント貯めると満タンになる。"
        }
      ],
      "relatedShipments": ["action_camera_2_cumulative", "defense_module_2"],
      "sources": ["rri-raid", "rri-barter", "rri-items", "rrg-items", "wiki-decoder", "steam-1117", "rri-cumulative"]
    },
