    {
      "id": "drill",
      "nameJa": "ドリル",
      "nameEn": "Drill",
      "categoryJa": "ドリル",
      "rarity": "Legendary",
      "gameIds": ["drill_1"],
      "usageJa": [
        { "text": "Looty Bay の銀行（ダウンタウン）の金庫室の扉を破る道具。金庫室はドリルでしか破れない。", "sources": ["rrg-text", "rri-faq", "rri-items"] },
        { "text": "破り始めると街全体に知らされる。警官はドリルを没収できる。", "sources": ["rrg-text", "rri-faq"] },
        { "text": "金庫室の中：貸金庫12個、現金（$10,000）の置き場所6か所、銀行の現金袋（貨物）5個、金庫3個。", "sources": ["rrg-map"] },
        { "text": "奥の「金の保管庫」にはドリルに加えて IDカード（銀行の金の保管庫）が必要。中には金塊の置き場所が7か所。", "sources": ["rrg-map", "wiki-keys"] }
      ],
      "timeNote": "未確認。ゲーム内の説明は「作業にかなり時間がかかり、とてもうるさい」で、秒数を載せた出典は見つからない。",
      "timeSources": ["rri-items", "rrg-items"],
      "statsJa": [
        { "label": "スタック", "value": "1個", "sources": ["rrg-items"] },
        { "label": "売値（故買屋）", "value": "$32,800", "sources": ["rri-items", "rrg-items"] },
        { "label": "サイズ", "value": "3×2", "sources": ["rri-items", "rrg-items"] }
      ],
      "obtainJa": [
        { "text": "物々交換でのみ入手（レニーのモーテルの怪しいドア）。", "sources": ["rri-items", "rrg-items", "wiki-heists"] }
      ],
      "barter": [
        {
          "inputs": [
