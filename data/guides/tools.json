      "relatedShipments": ["usb_1_cumulative", "action_camera_2_cumulative", "deposit_box_1_cumulative", "mini_drill_1"],
      "sources": ["rrg-text", "rri-faq", "rri-items", "rrg-items", "rrg-map", "rri-barter", "wiki-heists", "wiki-keys", "rri-cumulative"]
